# Digital Bridges — environment template. Copy to .env and fill in real values.
# Used by docker-compose.yml. For local (non-Docker) dev, see server/.env.example.

# --- Postgres ---
POSTGRES_USER=digitalbridges
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=digitalbridges

# --- API ---
# Must be long and random in production (used to sign login tokens).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d
# Browser origin allowed to call the API (the web container's public URL).
CORS_ORIGIN=http://localhost:8080

# --- Media (optional) ---
# Cloudinary credentials enable image uploads in the admin. Leave blank to
# disable (admins paste image URLs instead).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digital-bridges

# --- Web ---
WEB_PORT=8080
