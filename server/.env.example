# Local (non-Docker) development for the API. Copy to server/.env.
# `npm run dev` loads this via node --env-file=.env.
PORT=4000
DATABASE_URL=postgresql://digitalbridges:digitalbridges@localhost:5432/digitalbridges
JWT_SECRET=dev-secret-change-me-at-least-32-characters-long
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173

# Cloudinary (optional) — enables image uploads in the admin.
# Leave blank to disable uploads (admins paste image URLs instead).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digital-bridges

# AI (optional, Google Gemini) — enables the learner chatbot and admin quiz help.
# Get a free key at aistudio.google.com. Leave blank to disable AI features.
GEMINI_API_KEY=
# Free tier is a Flash model; override if Google renames the current one.
GEMINI_MODEL=gemini-2.0-flash

# SMTP email (optional) — welcome emails and workshop notifications.
# Works with any provider: Brevo, Gmail, Outlook/Microsoft 365, Hostinger, SendGrid…
# Leave SMTP_HOST/USER/PASS blank to disable email (the app runs normally).
# Port 465 -> SMTP_SECURE=true ; port 587 or 25 -> SMTP_SECURE=false (STARTTLS).
#   Brevo:     SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   Gmail:     SMTP_HOST=smtp.gmail.com         SMTP_PORT=587  (use an App Password)
#   Outlook:   SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
#   Hostinger: SMTP_HOST=smtp.hostinger.com     SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header shown to recipients. Falls back to SMTP_USER if blank.
SMTP_FROM=Digital Bridges <no-reply@yourdomain.org>
# Public URL of the app, used for links inside emails.
APP_URL=http://localhost:5173
